# Statesmen AI — environment template
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored. Both runtime (Next.js API routes) and CLI scripts (in
# `scripts/`) load these variables. On Vercel, `vercel env pull .env.local`
# fills most of them in.

# ─── Chat ─────────────────────────────────────────────────────────────────────

# Groq — streams persona chat replies. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the chat model. Default: qwen/qwen3.8-27b
# GROQ_CHAT_MODEL=qwen/qwen3.8-27b

# ─── Embeddings ───────────────────────────────────────────────────────────────

# Modal-hosted Qwen3-Embedding-0.6B (see infra/embed.py). OpenAI-compatible
# endpoint at $EMBED_URL/v1/embeddings, sent as `Authorization: Bearer <key>`.
EMBED_URL=
EMBED_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────

# Neon Postgres with pgvector (schema: db/schema.sql). Injected automatically
# by the Vercel Neon integration. The app uses the pooled URL; the unpooled
# one is for running db/schema.sql with psql.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
